
<!-- CABEÇALHO -->
<div class="dashboard-heading">
  <div>
    <span class="dashboard-eyebrow">
      ORGANIZAÇÃO FINANCEIRA
    </span>

    <h1>{{titulo}}</h1>

    <p>
      Organize suas receitas e despesas
      utilizando categorias.
    </p>
  </div>

  <a href="/categoriaList" class="btn btn-outline-primary">
    Voltar às categorias
  </a>
</div>

<!-- FORMULÁRIO -->
<form action="{{action}}" method="POST">
  
  <input type="hidden" name="_csrf" value="{{csrfToken}}">

  <input
    type="hidden"
    name="id"
    value="{{categoria.id}}"
  >

  <div class="card mb-4">

    <div class="card-header">
      <strong>Informações da categoria</strong>

      <div class="text-muted small mt-1">
        Defina um nome para identificar
        suas movimentações financeiras.
      </div>
    </div>

    <div class="card-body">

      <div class="form-group mb-2">
        <label for="nome">
          Nome da categoria
        </label>

        <input
          type="text"
          id="nome"
          name="nome"
          class="form-control"
          value="{{categoria.nome}}"
          placeholder="Ex.: Alimentação, Transporte, Saúde..."
          maxlength="100"
          required
        >

        <small class="form-text text-muted mt-2">
          Utilize um nome claro e fácil de identificar.
        </small>
      </div>

    </div>
  </div>

  <!-- BOTÕES -->
  <div class="form-actions">

    <a href="/categoriaList"
       class="btn btn-outline-secondary">
      Cancelar
    </a>

    <button type="submit" class="btn btn-success">
      Salvar categoria
    </button>

  </div>

</form>
